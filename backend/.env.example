PORT=5000
# PerfectCorp / YouCam V2 API key, sent as a Bearer token on every request.
# Generate one at https://yce.makeupar.com/api-console/en/api-keys/
PERFECTCORP_API_KEY=your_api_key_here
PERFECTCORP_BASE_URL=https://yce-api-01.makeupar.com

# Firebase Admin (Firestore) service-account credentials for scan history.
# From the service-account JSON: project_id, client_email, private_key.
# Keep the private key on one line with literal \n for the newlines, in quotes.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
